# Copy this file to ".env" if you want to change a setting. All lines are optional.

# Secret used to sign login sessions. If you leave it out, a random one is created
# automatically in instance/secret_key the first time you run the app.
# SECRET_KEY=put-a-long-random-text-here

# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Set to 1 to auto-reload Python code while developing.
FLASK_DEBUG=0
